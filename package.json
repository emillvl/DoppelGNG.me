{
  "name": "doppelgng.me",
  "version": "0.1.0",
  "private": true,
  "description": "Local, resumable website reconstruction using an existing crawler and headless Waterfox",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "runtime:check": "node scripts/python.mjs -m doppelgng.bootstrap --offline",
    "package": "node scripts/python.mjs -m doppelgng.distribution",
    "crawl": "node scripts/python.mjs -m doppelgng capture",
    "validate": "node scripts/python.mjs -m doppelgng validate",
    "status": "node scripts/python.mjs -m doppelgng status",
    "export": "node scripts/python.mjs -m doppelgng export",
    "dev": "node server.mjs",
    "test": "node scripts/python.mjs -m unittest discover -s tests -v && node --test tests/server.test.mjs"
  }
}
